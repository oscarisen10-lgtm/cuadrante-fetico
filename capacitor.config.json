{
  "appId": "com.cuadrantefetico.app",
  "appName": "Mi Cuadrante",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  },
  "server": {
    "iosScheme": "capacitor",
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#ffffff",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
