# Plantilla de variables de entorno para desarrollo local (npm run dev / npm run build).
# Copia este fichero a .env y rellena los valores reales — NUNCA subas .env con datos
# reales al repositorio (ya está en .gitignore).
#
# Los valores de Firebase salen de Firebase Console > Configuración del proyecto >
# tus apps > Config del SDK. Las builds de release (Codemagic) NO usan este fichero:
# las mismas variables viven en el grupo cifrado `firebase_config` de Codemagic
# (ver codemagic.yaml).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Console > Cloud Messaging > Certificados push web ("Generar par de claves").
# Sin esta clave, getToken() falla en web (el push nativo no la necesita).
VITE_FIREBASE_VAPID_KEY=

# Solo para mostrar a quién escribir en los textos de contacto/soporte de la app.
# NO decide quién es admin (eso va por custom claim, ver functions/lib/auth.js
# y scripts/set-admin-claim.js).
VITE_ADMIN_EMAIL=

# Opcional, y solo cuando se active App Check (ver docs/APP-CHECK.md). Mientras esté
# vacía, App Check queda inerte en el cliente (no engorda el bundle ni se ejecuta).
VITE_APPCHECK_SITE_KEY=
