rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    // Perfil del usuario autenticado. get() se cachea por petición, así que
    // llamarlo varias veces dentro de una misma regla cuenta como UNA lectura.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profile;
    }

    // Clave de sección: "Empresa_Tienda_Seccion" (debe coincidir con el cliente).
    function myStoreKey() {
      let p = myProfile();
      return p.company + "_" + p.store + "_" + p.section;
    }

    // Admin por custom-claim (recomendado) con fallback al email histórico
    // para no perder acceso durante la migración a claims.
    function isAdmin() {
      return request.auth != null && request.auth.token != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == "oscargarcia@fetico.es"
      );
    }

    function amIBoss() {
      let p = myProfile();
      return 'rank' in p && p.rank.matches('(?i).*(jefe|coordinador|gestor|segundo).*');
    }

    // Jefe directo del usuario objetivo: mismo equipo (empresa+tienda+sección).
    function isDirectBossOf(targetUid) {
      let me = myProfile();
      let them = get(/databases/$(database)/documents/users/$(targetUid)).data.profile;
      return amIBoss() &&
             me.company == them.company &&
             me.store == them.store &&
             me.section == them.section;
    }

    // Jefe de la sección de la que procede la petición.
    function isDirectBossOfRequest(reqData) {
      return amIBoss() && myStoreKey() == reqData.storeKey;
    }

    // Validación de un turno (evita que el cliente escriba basura/campos enormes).
    function validShift(d) {
      return d.type in ['work', 'rest', 'vacation', 'sick'] &&
             d.date is string && d.date.size() <= 10 &&
             (!('hours' in d) || d.hours is number);
    }

    // ---------- Usuarios ----------
    match /users/{userId} {
      // Lectura PRIVADA: SOLO el propio usuario, su jefe directo de sección, o el admin.
      // (Antes cualquier compañero de la misma tienda podía leer email + fcmToken de
      // toda la plantilla = fuga de datos personales. Para los recuentos de equipo
      // —¿puedo pedir día libre?, ¿hay hueco de responsable?— el cliente ya NO lee
      // perfiles ajenos: usa la Cloud Function `teamStatus`, que devuelve solo cifras.)
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        isDirectBossOf(userId)
      );

      // Solo el propio usuario (o el admin) puede modificar su perfil.
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Turnos: subcolección por usuario.
      match /shifts/{shiftId} {
        // Lectura: dueño, jefe directo de la sección, o admin.
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          isDirectBossOf(userId) ||
          isAdmin()
        );
        // Borrado: dueño, jefe directo, o admin.
        allow delete: if request.auth != null && (
          request.auth.uid == userId ||
          isDirectBossOf(userId) ||
          isAdmin()
        );
        // Alta/edición: además de los permisos, el turno debe tener forma válida.
        allow create, update: if request.auth != null && (
          request.auth.uid == userId ||
          isDirectBossOf(userId) ||
          isAdmin()
        ) && validShift(request.resource.data);
      }

      // Cuota de uso de la IA: la escribe SOLO el backend (Admin SDK ignora reglas).
      // El cliente puede leer su propia cuota; nadie puede escribirla desde el cliente.
      match /usage/{usageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // ---------- Peticiones (requests) ----------
    match /requests/{requestId} {
      // Lectura ACOTADA: solo el dueño o el jefe de la sección correspondiente.
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        isDirectBossOfRequest(resource.data) ||
        isAdmin()
      );
      // Creación: solo para uno mismo y con el storeKey REAL de su perfil
      // (impide falsear la sección a la que se enruta la petición).
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.storeKey == myStoreKey();
      // Actualización: dueño, jefe de la sección, o admin. Además, uid y storeKey
      // son INMUTABLES (no se puede re-enrutar ni cambiar de dueño una petición).
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        isDirectBossOfRequest(resource.data) ||
        isAdmin()
      ) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.storeKey == resource.data.storeKey;
      allow delete: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        isDirectBossOfRequest(resource.data) ||
        isAdmin()
      );
    }

    // ---------- Noticias (requiere sesión) ----------
    match /noticias/{noticiaId} {
      allow read: if request.auth != null;
      // Alta solo admin y con createdAt válido (lo usa la ordenación y la limpieza
      // programada). isPushRequest, si viene, debe ser booleano.
      allow create: if isAdmin() &&
        request.resource.data.createdAt is number &&
        (!('isPushRequest' in request.resource.data) || request.resource.data.isPushRequest is bool);
      allow update, delete: if isAdmin();
    }

    // ---------- Licencias (requiere sesión) ----------
    match /licencias/{licenciaId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------- Caché de IA: solo backend ----------
    match /ai_cache/{docId} {
      allow read, write: if false;
    }

    // ---------- Rankings de la Competición ----------
    // Cualquier usuario con sesión puede VER los rankings; solo el backend
    // (función submitArenaScore vía Admin SDK) puede escribir las puntuaciones.
    match /leaderboards/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Por defecto, denegar todo lo demás (el admin conserva acceso de soporte).
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
