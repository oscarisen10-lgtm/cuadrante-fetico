rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    // Perfil del usuario autenticado. get() se cachea por petición, así que
    // llamarlo varias veces dentro de una misma regla cuenta como UNA lectura.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profile;
    }

    // Clave de sección: "Empresa_Tienda_Seccion" (debe coincidir con el cliente).
    function myStoreKey() {
      let p = myProfile();
      return p.company + "_" + p.store + "_" + p.section;
    }

    // Admin SOLO por custom-claim. El fallback por email se ELIMINÓ el
    // 17-jul-2026 tras el incidente de borrado: el email de un token puede no
    // estar verificado, mientras que el claim solo lo pone el backend/owner
    // (scripts/set-admin-claim.js). Si el admin pierde acceso: re-ejecutar ese
    // script y cerrar/abrir sesión.
    function isAdmin() {
      return request.auth != null && request.auth.token != null &&
        request.auth.token.admin == true;
    }

    // ⚠️ SEGURIDAD (escalada de privilegios): el "rango" (jefe/coordinador…) lo
    // ELIGE el propio usuario en Ajustes; NO está verificado. Por eso el rango NO
    // puede otorgar acceso a los datos de otros compañeros: si lo hiciera, cualquiera
    // podría autoproclamarse "jefe" (con una simple llamada REST) y leer/editar los
    // turnos y el perfil —email, fcmToken— de toda su sección.
    //
    // Las vistas de equipo (TeamView / "Empleados") están OCULTAS en el cliente. Cuando
    // se reactiven, los recuentos y datos de equipo deben servirse desde una Cloud
    // Function con el Admin SDK (como ya hace `teamStatus`), NUNCA leyendo perfiles
    // ajenos desde el cliente. Hasta entonces: cada usuario solo accede a lo suyo, y
    // el admin conserva acceso de soporte.

    // Validación de un turno (evita que el cliente escriba basura/campos enormes).
    function validShift(d) {
      return d.type in ['work', 'rest', 'vacation', 'sick'] &&
             d.date is string && d.date.size() <= 10 &&
             (!('hours' in d) || d.hours is number);
    }

    // ---------- Activación de cuentas (sistema de delegados) ----------
    // users/{uid}.membership.active gobierna si la cuenta está activada.
    // membership AUSENTE = cuenta anterior al sistema de delegados → ACTIVA
    // (los usuarios existentes quedan activados sin migración). Solo el backend
    // (delegadoSetActive/adminSetDelegado, Admin SDK) escribe membership: el
    // propio usuario NUNCA puede tocarlo, o se autoactivaría por REST.
    function isActiveMember() {
      let d = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return !('membership' in d) || d.membership.active == true;
    }

    // ---------- Usuarios ----------
    match /users/{userId} {
      // Lectura PRIVADA: SOLO el propio usuario o el admin. Ningún compañero (ni
      // "jefe" autodeclarado) puede leer el perfil de otro (email + fcmToken = PII).
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin()
      );

      // Alta: los registros nuevos nacen SIEMPRE desactivados (membership.active
      // == false). Una app antigua (que no envía membership) no puede crear
      // cuentas nuevas: solo así se garantiza que nadie nazca activado.
      allow create: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId &&
         'membership' in request.resource.data &&
         request.resource.data.membership.active == false)
      );

      // Edición: el propio usuario puede modificar su perfil pero NO membership
      // (ni añadirlo, ni cambiarlo, ni borrarlo). El admin sí.
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['membership']))
      );

      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Turnos DIARIOS (modelo antiguo): subcolección por usuario. Solo el dueño
      // (o el admin) accede. Se mantiene por compatibilidad con builds antiguas
      // (la app nueva escribe aquí en dual-write pero LEE el modelo mensual).
      match /shifts/{shiftId} {
        allow read, delete: if request.auth != null && (
          request.auth.uid == userId ||
          isAdmin()
        );
        // Alta/edición: dueño con turno de forma válida. Las cuentas PENDIENTES
        // sí pueden registrar jornada ('work': el apartado Fichar está abierto
        // para ellas a propósito), pero NO libres/vacaciones/bajas — eso se
        // desbloquea al activar la cuenta. El tipo se comprueba ANTES que
        // isActiveMember() para ahorrarse el get() en el caso común.
        allow create, update: if request.auth != null && (
          (request.auth.uid == userId &&
           (request.resource.data.type == 'work' || isActiveMember())) ||
          isAdmin()
        ) && validShift(request.resource.data);
      }

      // Turnos MENSUALES (modelo v2): users/{uid}/shiftMonths/{YYYY-MM} con un
      // mapa days { "DD": {type, hours, isHA, turn} }. Cargar un año = 12
      // lecturas (antes ~365 con el modelo diario). Las reglas no pueden iterar
      // mapas, así que aquí se valida la FORMA del documento; el detalle por día
      // lo controla la interfaz (y Fichar está abierto a cuentas pendientes a
      // propósito, igual que arriba).
      match /shiftMonths/{monthId} {
        allow read, delete: if request.auth != null && (
          request.auth.uid == userId ||
          isAdmin()
        );
        allow create, update: if request.auth != null && (
          request.auth.uid == userId ||
          isAdmin()
        ) &&
          request.resource.data.keys().hasOnly(['month', 'days']) &&
          request.resource.data.month is string &&
          request.resource.data.month.size() == 7 &&
          request.resource.data.days is map;
      }

      // HEREDADO: era la cuota diaria del asistente de IA, eliminado el 28-jul-2026.
      // Ya nadie lee ni escribe aquí. `dailyCleanup` (la function que lo purgaba) se
      // retiró el 05-ago-2026 antes de confirmar que esta colección quedara a cero:
      // si queda algún doc suelto, hay que purgarlo a mano con el Admin SDK. Mientras
      // tanto se deniega todo acceso desde el cliente (el Admin SDK ignora las reglas).
      match /usage/{usageId} {
        allow read, write: if false;
      }
    }

    // ---------- Peticiones (requests) ----------
    match /requests/{requestId} {
      // Lectura ACOTADA: solo el dueño (o el admin). El jefe de sección ya no lee
      // peticiones ajenas desde el cliente (ver nota de seguridad arriba); cuando se
      // reactive la aprobación por responsables, se hará vía Cloud Function.
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      // Creación: solo para uno mismo, con cuenta ACTIVADA y con el storeKey REAL
      // de su perfil (impide falsear la sección a la que se enruta la petición).
      //
      // El flujo de "pedir día libre" se retiró del cliente el 28-jul-2026, pero las
      // builds ANTIGUAS que aún no han actualizado siguen creando peticiones: por eso
      // `create` sigue permitido. La lista de campos es EXACTAMENTE la que escribían
      // esas builds — no ampliarla sin comprobar el historial (`git show 85eb138`).
      // Sin este hasOnly, un usuario activo podía escribir campos arbitrarios y
      // cadenas de hasta 1 MB en su propia petición, inflando coste y almacenamiento.
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        isActiveMember() &&
        request.resource.data.storeKey == myStoreKey() &&
        request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'company', 'store', 'section',
          'storeKey', 'date', 'status', 'note', 'createdAt'
        ]) &&
        request.resource.data.date is string && request.resource.data.date.size() <= 10 &&
        request.resource.data.status == 'pending' &&
        // createdAt lo añade addRequest() en el cliente, pero se valida como
        // OPCIONAL a propósito: exigirlo rechazaría escrituras por lo demás
        // válidas de builds antiguas que no lo enviaran. Si viene, debe ser número.
        (!('createdAt' in request.resource.data) ||
          request.resource.data.createdAt is number) &&
        (!('note' in request.resource.data) ||
          (request.resource.data.note is string && request.resource.data.note.size() <= 500)) &&
        (!('fullName' in request.resource.data) ||
          (request.resource.data.fullName is string && request.resource.data.fullName.size() <= 100));
      // Actualización: el dueño puede retocar su petición (p.ej. la nota) pero
      // NO su status (nadie se autoaprueba: cuando exista flujo de aprobación,
      // lo cambiará el backend), ni uid/storeKey (inmutables). Para cancelar,
      // el dueño BORRA la petición. El admin conserva acceso de soporte.
      allow update: if request.auth != null && (
        isAdmin() ||
        (resource.data.uid == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'storeKey', 'status']) &&
         request.resource.data.keys().hasOnly([
           'uid', 'fullName', 'company', 'store', 'section',
           'storeKey', 'date', 'status', 'note', 'createdAt'
         ]) &&
         (!('note' in request.resource.data) ||
           (request.resource.data.note is string && request.resource.data.note.size() <= 500)))
      );
      allow delete: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
    }

    // ---------- Noticias GLOBALES (requiere sesión) ----------
    // SOLO el admin publica aquí: es el canal "a toda la app". Las noticias de
    // los delegados van en noticiasTienda (abajo), NUNCA en esta colección.
    match /noticias/{noticiaId} {
      allow read: if request.auth != null;
      // Alta solo admin y con createdAt válido (lo usa la ordenación y la limpieza
      // programada). isPushRequest, si viene, debe ser booleano.
      allow create: if isAdmin() &&
        request.resource.data.createdAt is number &&
        (!('isPushRequest' in request.resource.data) || request.resource.data.isPushRequest is bool);
      allow update, delete: if isAdmin();
    }

    // ---------- Noticias de DELEGADO (por tienda) ----------
    // noticiasTienda/{id}: cada doc lleva stores[] con las tiendas DESTINO.
    // Privacidad en servidor: un usuario solo puede leer las noticias cuyo
    // stores[] contenga SU tienda (el feed consulta con array-contains su
    // tienda real, así la regla es demostrable). El autor ve las suyas y el
    // admin todo. Publicar exige ser delegado ACTIVO y que stores[] sea un
    // subconjunto de sus tiendas autorizadas: ni con la API a mano se puede
    // publicar a tiendas ajenas ni a toda la app.
    function myDelegado() {
      return get(/databases/$(database)/documents/delegados/$(request.auth.uid)).data;
    }
    function isActiveDelegado() {
      return exists(/databases/$(database)/documents/delegados/$(request.auth.uid)) &&
        myDelegado().active != false;
    }

    match /noticiasTienda/{noticiaId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.authorUid == request.auth.uid ||
        myProfile().store in resource.data.stores
      );
      allow create: if request.auth != null && (
        isAdmin() ||
        (isActiveDelegado() &&
         request.resource.data.authorUid == request.auth.uid &&
         request.resource.data.stores is list &&
         request.resource.data.stores.size() > 0 &&
         myDelegado().stores.hasAll(request.resource.data.stores) &&
         request.resource.data.createdAt is number &&
         request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
         request.resource.data.desc is string && request.resource.data.desc.size() <= 5000)
      );
      // Sin ediciones (se borra y se vuelve a publicar); borra el autor o el admin.
      allow update: if isAdmin();
      allow delete: if request.auth != null && (
        isAdmin() ||
        resource.data.authorUid == request.auth.uid
      );
    }

    // ---------- Licencias (requiere sesión) ----------
    match /licencias/{licenciaId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------- Delegados ----------
    // delegados/{uid} define qué tiendas gestiona cada delegado. El propio
    // delegado lo lee (así su app sabe si mostrarle la pestaña "Delegados");
    // solo el admin lo escribe (en la práctica, vía la función adminSetDelegado).
    match /delegados/{delegadoId} {
      allow read: if request.auth != null && (request.auth.uid == delegadoId || isAdmin());
      allow write: if isAdmin();
    }

    // ---------- Censo de afiliación (delegados) ----------
    // censos/{uid}: UN solo documento por delegado con sus "futuros usuarios"
    // apuntados a mano, agrupados por tienda. Diseño de coste mínimo: cargar el
    // censo entero = 1 lectura; cada alta/baja de futuro = 1 escritura. Solo el
    // dueño (o el admin) lo lee y escribe, y solo con los campos previstos.
    match /censos/{censoId} {
      allow read: if request.auth != null && (request.auth.uid == censoId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == censoId || isAdmin()) &&
        request.resource.data.keys().hasOnly(['prospects', 'updatedAt']);
    }

    // ---------- HEREDADO: caché del asistente de IA (eliminado el 28-jul-2026) ----------
    // Nada la escribe ya. Confirmada vacía (8 días seguidos en 0 antes de retirar
    // `dailyCleanup`, la function que la purgaba, el 05-ago-2026). Denegada al cliente.
    match /ai_cache/{docId} {
      allow read, write: if false;
    }

    // (La Arena/Competición y sus rankings `leaderboards` se eliminaron del
    // proyecto el 17-jul-2026; la colección se purgó y la regla se retiró.)

    // Por defecto, denegar todo lo demás (el admin conserva acceso de soporte).
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
