rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Admin SOLO por custom-claim, igual que en firestore.rules (el fallback por
    // email se eliminó el 17-jul-2026 tras el incidente de borrado).
    // El `'admin' in` es obligatorio: sin él, un token sin el claim hace que la
    // expresión LANCE en vez de devolver false (ver la nota en firestore.rules).
    function isAdmin() {
      return request.auth != null && request.auth.token != null &&
        'admin' in request.auth.token && request.auth.token.admin == true;
    }

    // Delegado ACTIVO: se comprueba su doc en Firestore (reglas cross-service).
    function esDelegadoActivo() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/delegados/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/delegados/$(request.auth.uid)).data.active != false;
    }

    // Imagen aceptable: comprimida en el dispositivo (~150-400 KB); 5 MB es el cinturón.
    function esImagenRazonable() {
      return request.resource.size < 5 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*');
    }

    // Noticias GLOBALES: solo admin puede subir, todos los autenticados pueden leer
    // (son avisos "a toda la app", no hay nada que acotar por tienda).
    match /noticias/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && esImagenRazonable();
    }

    // Fotos de las noticias de DELEGADO, ACOTADAS POR TIENDA.
    // Ruta: noticias-delegado/{authorUid}/{noticiaId}/{fileName}
    //
    // ⚠️ Por qué la ruta lleva el id de la noticia (auditoría 22-ago-2026): antes los
    // carteles vivían planos en noticias-delegado/{Date.now()}_cartel.jpg — un nombre
    // ADIVINABLE — y la regla de lectura era solo "estar autenticado". Cualquier usuario
    // podía pedir el cartel de una tienda que no era la suya, mientras que el documento
    // equivalente en Firestore sí filtraba por tienda. Con el id de la noticia en la ruta
    // se puede exigir lo mismo que en Firestore: que la tienda del lector esté entre las
    // tiendas destino de esa noticia.
    //
    // Coste: los lectores normales NO pasan por aquí (el feed usa la imageUrl con token
    // que ya viene en el documento), así que estas comprobaciones cross-service casi
    // nunca llegan a ejecutarse.
    //
    // El autor puede leer siempre lo suyo, y la rama va la PRIMERA a propósito: al subir,
    // el cliente llama a getDownloadURL() cuando la noticia todavía no existe en Firestore.
    match /noticias-delegado/{authorUid}/{noticiaId}/{fileName} {
      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == authorUid ||
        (firestore.exists(/databases/(default)/documents/noticiasTienda/$(noticiaId)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.profile.store
           in firestore.get(/databases/(default)/documents/noticiasTienda/$(noticiaId)).data.stores)
      );
      // Solo se sube bajo la carpeta de uno mismo: así `authorUid` no se puede falsear
      // para colar una imagen en el espacio de otro delegado.
      allow write: if request.auth != null &&
                      request.auth.uid == authorUid &&
                      (isAdmin() || esDelegadoActivo()) &&
                      esImagenRazonable();
    }

    // HEREDADO: carteles subidos a la ruta plana antes del 22-ago-2026. Se mantiene la
    // LECTURA para que las noticias antiguas se sigan viendo, pero ya no se admite subir
    // aquí: todo lo nuevo va a la ruta con {authorUid}/{noticiaId} de arriba. Cuando
    // caduquen las noticias viejas, este bloque se puede borrar entero.
    match /noticias-delegado/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Denegar todo lo demás
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
